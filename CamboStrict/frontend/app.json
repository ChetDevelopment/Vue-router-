{
  "expo": {
    "name": "TokLok Cambodia",
    "slug": "toklok-cambodia",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toklok",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kh.toklok.app",
      "associatedDomains": ["applinks:toklok.kh"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "kh.toklok.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "toklok",
              "host": "*",
              "pathPrefix": "/post"
            },
            {
              "scheme": "toklok",
              "host": "*",
              "pathPrefix": "/user"
            },
            {
              "scheme": "https",
              "host": "toklok.kh",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "toklok.kh",
              "pathPrefix": "/user"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "TokLok needs camera access to record and share videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TokLok needs photo library access to upload media."
        }
      ],
      "expo-video",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D85A30"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "toklok-cambodia"
      }
    }
  }
}
